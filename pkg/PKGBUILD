# Maintainer: canxphung <https://github.com/canxphung>
#
# PKGBUILD dùng khi phát triển: build từ chính repo đang checkout (thư mục
# cha của pkg/), kể cả thay đổi chưa commit. Cách dùng:
#   cd pkg && makepkg -si
# Bản phát hành sau này sẽ lấy source từ git tag.

pkgbase=glass-desktop
pkgname=(glass-desktop glass-session glassd glass-shell glass-sddm)
pkgver=0.4.0
pkgrel=1
pkgdesc='Glass: desktop Aero trên Hyprland, tối ưu cho CachyOS'
arch=(x86_64)
url='https://github.com/canxphung/dotfile-glass'
license=(MIT)
makedepends=(git cargo)
# Cờ build Rust (RUSTFLAGS) lấy từ makepkg.conf, nên trên CachyOS glassd
# được build với cờ tối ưu của CachyOS.

_root() {
    realpath "$startdir/.."
}

pkgver() {
    cd "$(_root)"
    printf '0.4.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$(_root)/daemon"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$(_root)"
    export RUSTUP_TOOLCHAIN=stable
    make build PREFIX=/usr CARGOFLAGS=--frozen
}

check() {
    cd "$(_root)/daemon"
    export RUSTUP_TOOLCHAIN=stable
    cargo test --frozen
}

_license() {
    install -Dm644 "$(_root)/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_glass-desktop() {
    pkgdesc='Glass: desktop Aero trên Hyprland (gói tổng)'
    arch=(any)
    depends=(glass-session glassd glass-shell glass-sddm)
    _license
}

package_glass-session() {
    pkgdesc='Glass: phiên Hyprland, config mặc định, portal và script'
    arch=(any)
    depends=(
        # compositor và các tool đi kèm
        hyprland hyprlock hypridle hyprpaper hyprpolkitagent hyprshutdown
        # portal, keyring
        xdg-desktop-portal-hyprland xdg-desktop-portal-gtk gnome-keyring
        # bộ gõ tiếng Việt
        fcitx5 fcitx5-bamboo fcitx5-gtk fcitx5-qt fcitx5-configtool
        # app và tiện ích dùng trong phím tắt
        kitty qt6ct wireplumber brightnessctl playerctl
        grim slurp wl-clipboard xdg-user-dirs dbus libnotify
        # font
        ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji
    )
    optdepends=(
        'noto-fonts-cjk: hiển thị chữ Trung, Nhật, Hàn'
    )
    backup=(etc/xdg/xdg-desktop-portal/hyprland-portals.conf)

    make -C "$(_root)" DESTDIR="$pkgdir" PREFIX=/usr install-session
    _license
}

package_glassd() {
    pkgdesc='Glass: daemon settings (glassd), agent mật khẩu Wi-Fi và ghép nối Bluetooth, dòng lệnh glassctl'
    depends=(
        glass-session glibc gcc-libs dbus systemd
        # lệnh glassd gọi khi áp settings
        glib2 hyprland hyprsunset procps-ng
    )
    optdepends=(
        'networkmanager: agent hỏi mật khẩu Wi-Fi'
        'bluez: agent xác nhận mã ghép nối Bluetooth'
    )

    make -C "$(_root)" DESTDIR="$pkgdir" PREFIX=/usr install-daemon
    _license
}

package_glass-shell() {
    pkgdesc='Glass: shell Quickshell (taskbar, start menu, control center, thông báo, OSD)'
    arch=(any)
    depends=(
        glass-session 'quickshell>=0.3.0'
        # icon trên taskbar, menu
        ttf-nerd-fonts-symbols
        # lệnh shell gọi: mở thư mục, chạy app trong scope riêng
        xdg-utils systemd
        # Wi-Fi, âm thanh trong control center
        networkmanager pipewire wireplumber
    )
    optdepends=(
        'glassd: đổi màu theo palette, hỏi mật khẩu Wi-Fi và mã ghép nối Bluetooth'
        'bluez: Bluetooth trong control center'
        'upower: hiện pin trên taskbar (laptop)'
        'power-profiles-daemon: chế độ tiết kiệm pin / hiệu năng trong control center'
        'papirus-icon-theme: icon app và khay, khi chưa chọn icon theme trong qt6ct'
    )

    make -C "$(_root)" DESTDIR="$pkgdir" PREFIX=/usr install-shell
    _license
}

package_glass-sddm() {
    pkgdesc='Glass: cấu hình SDDM, greeter chạy Wayland qua weston'
    arch=(any)
    depends=(sddm weston)

    make -C "$(_root)" DESTDIR="$pkgdir" PREFIX=/usr install-sddm
    _license
}
