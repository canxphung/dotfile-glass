[Unit]
Description=Glass: xử lý khi máy rảnh (hypridle)
Documentation=https://wiki.hypr.land/Hypr-Ecosystem/hypridle/
PartOf=graphical-session.target
After=graphical-session.target glassd.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/hypridle --config %E/glass/hypridle.conf
Restart=on-failure
Slice=session.slice
