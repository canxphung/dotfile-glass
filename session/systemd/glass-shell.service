[Unit]
Description=Glass: shell (taskbar, start menu, thông báo)
Documentation=https://github.com/canxphung/dotfile-glass
PartOf=graphical-session.target
After=graphical-session.target glassd.service
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=exec
ExecStart=@BINDIR@/glass-shell
Restart=on-failure
RestartSec=1
# App mở từ shell chạy trong scope riêng (glass-session run), nên khởi động
# lại shell không đóng app.
Slice=session.slice
